ENVIRONMENT=development
DEPLOYMENT_ENVIRONMENT=local
APP_COMPONENT=web
APP_NAME=Cloud Inventory Site Discovery
APP_VERSION=0.2.0
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./discovery.db
SESSION_COOKIE_NAME=ci_discovery_session
SESSION_TTL_HOURS=12
BOOTSTRAP_ADMIN_USERNAME=Admin
BOOTSTRAP_ADMIN_PASSWORD=SET_AS_A_SECRET
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
DEFAULT_RETENTION_DAYS=1095
MERGE_SOURCE_RECOVERY_DAYS=30

STORAGE_MODE=local
LOCAL_STORAGE_ROOT=./local-storage
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=52428800

OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-5-mini
AI_ENABLED=false
AI_CONFIDENTIAL_CONTENT_ENABLED=false
OPENAI_DATA_CONTROL_MODE=standard-disabled-for-confidential

LIBREOFFICE_PATH=/usr/bin/libreoffice
DOCUMENT_WORK_DIR=/tmp/ci-discovery-documents
JOB_POLL_SECONDS=2
MAINTENANCE_INTERVAL_SECONDS=3600
RETENTION_WARNING_DAYS=30
LOG_LEVEL=INFO
